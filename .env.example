# העתק ל־.env והתאם ערכים
DATABASE_URL="postgresql://postgres:postgres@db:5432/caller_center?schema=public"

# מפתח הצפנת ה-session של NextAuth — חובה להחליף בפרודקשן (openssl rand -base64 32)
NEXTAUTH_SECRET="dev-change-me-please-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# הסוד המשותף שה-GIS ישלח בכותרת X-Webhook-Secret כדי לאמת את הוובהוק
GIS_WEBHOOK_SECRET="dev-webhook-secret-change-me"

# פרטי מנהל ראשוני שנוצר ב-seed
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="Admin!12345"
